{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vollmers-hofladen",
  "main": "_worker.js",
  "compatibility_date": "2026-10-12",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "kv_namespaces": [
    {
      "binding": "VOLLMERS_KV",
      "id": "80fdb23b3edf48f798cf9d2bbcdba13a"
    }
  ],
  "r2_buckets": [
    {
      "binding": "R2_BUCKET",
      "bucket_name": "website-datein"
    }
  ]
}
